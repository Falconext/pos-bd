# Database
DATABASE_URL="postgresql://user:password@localhost:5432/sistema_mype?schema=public"

# JWT
JWT_SECRET=your-secret-key-here
JWT_REFRESH_SECRET=your-refresh-secret-key-here

# API
PORT=4000
BACKEND_URL=http://localhost:4000
RENIEC_TOKEN=your-apiperu-token-here

# Frontend URL for CORS (production)
# FRONTEND_URL=https://your-frontend-domain.up.railway.app

# Twilio WhatsApp Business API
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886

# Zavu — WhatsApp vía API unificada (usar cuando empresa.whatsappProvider = ZAVU)
ZAVU_API_KEY=zv_test_xxxxxxxxxxxxxxxxxxxxxxxx
ZAVU_BASE_URL=https://api.zavu.dev/v1
# ZAVU_SENDER=  # opcional: id/número del sender si la cuenta tiene varios

# AWS S3 Configuration
AWS_ACCESS_KEY_ID=AKIAxxxxxxxxxxxxxxxxxxxx
AWS_SECRET_ACCESS_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
AWS_REGION=us-east-1
AWS_S3_BUCKET_NAME=your-bucket-name

# SUNAT
SUNAT_API_URL=https://api.sunat.gob.pe
QPSE_ACCESS_TOKEN=your-qpse-access-token-here
# El entorno QPSE se decide POR EMPRESA con empresa.usaDemo:
#   usaDemo=false -> QPSE_BASE_URL (produccion) | usaDemo=true -> QPSE_DEMO_BASE_URL (demo)
QPSE_BASE_URL=https://cpe.qpse.pe
QPSE_AUTH_BASE_URL=https://cpe.qpse.pe
QPSE_PANEL_BASE_URL=https://cpanel.qpse.pe
QPSE_DEMO_BASE_URL=https://demo-cpe.qpse.pe

# JAMBLE (opcional, para ajustar rutas si el reseller usa endpoints distintos)
JAMBLE_API_ISSUE_PATHS=/api/documents,/documents
JAMBLE_API_STATUS_PATH=/api/documents/{id}
JAMBLE_API_VOID_PATH=/api/documents/{id}/void
JAMBLE_API_SEND_PATHS=/api/documents/send,/documents/send,/api/documents/send/{id},/documents/send/{id}
JAMBLE_API_STATUS_PATHS=/api/documents/{id},/documents/{id},/api/documents/record/{id}
JAMBLE_API_LIST_PATHS=/api/documents/lists/{date_ini}/{date_end},/documents/lists/{date_ini}/{date_end}
# Recomendación: usar SOLO un método de autenticación por cliente:
# 1) Bearer token (billingApiToken) o 2) Basic auth (billingApiUser + billingApiPassword)
# Piso de correlativo por empresa y serie (opcional):
# Formato: empresaId:SERIE:CORRELATIVO,empresaId:SERIE:CORRELATIVO
# Ejemplo:
# JAMBLE_CORRELATIVO_FLOOR=43:B001:60,43:F001:16
JAMBLE_CORRELATIVO_FLOOR=
# Para JAMBLE, por defecto NO se fuerza /documents/send porque /documents ya confirma registro exitoso.
# Activar solo si el proveedor lo exige explícitamente.
JAMBLE_FORCE_DISPATCH=false

# SMTP (para envío de SIRE por correo)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tu-correo@gmail.com
SMTP_PASS=tu-contraseña-de-aplicacion
SMTP_FROM=tu-correo@gmail.com

# Sincronización Falconext Hotel (producto HOTEL)
HOTEL_BACKEND_SYNC_URL=http://localhost:5000/api/v1/autenticacion/sync-from-mype
HOTEL_BACKEND_SYNC_TOKEN=FALCONEXT_TOKEN_SY

# ── Shalom (courier) — dos proveedores según la empresa ──────────────────────
# Empresas de reseller (empresa.resellerId != null) → proveedor NUEVO (shalom-api.lat).
# Proveedor Shalom (toda falconext-mype): https://api.shalom-api.lat
# Auth por header `x-api-key` (una sola API key global). NO requiere cuenta
# Shalom Pro: cubre agencias, tracking, comprobante, etiqueta y cotización.
# La API key se solicita al proveedor (por WhatsApp).
SHALOM_LAT_API_KEY=
SHALOM_LAT_BASE_URL=https://api.shalom-api.lat

# Habilita/deshabilita los jobs de scheduler de SUNAT (verificación y reintentos).
# Ponlo en "false" en entornos de desarrollo que apunten a una BD compartida,
# para que esta instancia no reintente envíos por el entorno QPSE equivocado.
SUNAT_JOBS_ENABLED=true

# Habilita/deshabilita el rastreo automático de envíos Shalom (cada 30 min).
# Ponlo en "false" en desarrollo con BD compartida para no duplicar consultas
# al frágil upstream de Shalom ni pisar los estados del backend desplegado.
SHALOM_JOBS_ENABLED=true

# ── WhatsApp Cloud API ──────────────────────────────────────────────────────
# Credenciales de plataforma (número de Krezka) para empresas con provider=PLATFORM:
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
# Meta App para Embedded Signup (conectar el WhatsApp propio del empresario).
# Reutiliza la misma Meta App de salesfilter (plataforma unida).
FB_APP_ID=
META_APP_SECRET=
# Token de verificación del webhook de WhatsApp (si se habilita entrada):
META_VERIFY_TOKEN=

# Redis para la cola de mensajes del módulo de leads (BullMQ)
REDIS_URL=redis://localhost:6379
